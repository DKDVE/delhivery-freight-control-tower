# Cloud settings (Azure Container Apps). Copy to .env for a local dry run of the cloud configuration; never commit .env.
# In the real deployment these come from the Container App's environment/secrets (see infra/main.bicep), not from a file.

# LLM: Groq directly, through its OpenAI-compatible endpoint. freellmapi stays local-only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Pin ONE model ID. Do not use auto routing: it changes the model between calls.
LLM_MODEL=openai/gpt-oss-120b
# DEMO_MODE=0 forces live mode (requires LLM_API_KEY); DEMO_MODE=1 forces demo mode regardless of the key
DEMO_MODE=0

# Audit log: a directory, not a file. The cloud mounts the Azure Files share "audit" here; each replica appends to
# its own file (named by hostname) and reads merge every replica's file, so writes stay append-safe across replicas.
AUDIT_LOG_DIR=/mnt/audit

# Networking
PORT=8000
# Comma-separated allow-list, e.g. the Container App's FQDN. "*" (or unset) skips the check - fine for local dev only.
ALLOWED_HOSTS=*

# Access control: only used when Entra ID built-in auth is unavailable (shared-password fallback).
# The real value lives in the Container Apps secret "app-access-code", never in a committed file.
APP_ACCESS_CODE=
