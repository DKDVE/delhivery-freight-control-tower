// Freight Control Tower - errors in the last 24h.
// Run against the Log Analytics workspace named in infra/main.bicep (output logAnalyticsWorkspaceName),
// or save it there: Logs blade -> paste -> Save -> "FCT: errors (24h)".
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(24h)
| where ContainerAppName_s == "fct-app"
| where Log_s has_any ("Traceback", "ERROR", "Exception", "CRITICAL")
| project TimeGenerated, RevisionName_s, Log_s
| order by TimeGenerated desc
