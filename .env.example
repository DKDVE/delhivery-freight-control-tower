# Copy to .env (never commit .env). Leave LLM_API_KEY empty to run in DEMO_MODE (rule-based, fully offline).
# LLM_MODEL: pin ONE model ID listed by freellmapi (GET /v1/models). Do not use auto routing: it changes the model between calls.
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
# DEMO_MODE=1 forces demo mode even when a key is set; 0 forces live mode
DEMO_MODE=
